# Per-directory rules live in kine/.gitignore and npm/.gitignore. This covers
# the repo root only.
/node_modules/
/.env
/.env.*
!.env.example
*.log
.DS_Store

# Local agent scratch (launch configs, session settings)
.claude/

# Compiled gateway/tray binaries produced by `go build -o ../kinerouter`
/kinerouter
/kinerouter.exe
/kinerouter-tray
/kinerouter-dev
/kinerouter-dev.exe

# Local agent scratch (screenshots, session state)
/.openchamber/

# Local-only project workflow notes
WORKFLOW.md

# Graphify knowledge graph output (local, rebuild with `graphify extract . --code-only`)
graphify-out/
